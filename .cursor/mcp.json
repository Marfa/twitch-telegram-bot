{
  "mcpServers": {
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "viaduct": {
      "url": "https://mcp.quietgridlabs.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:VIADUCT_MCP_TOKEN}"
      }
    },
    "pingzen": {
      "url": "https://pingzen.dev/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:PINGZEN_MCP_TOKEN}"
      }
    },
    "aiven": {
      "type": "http",
      "url": "https://mcp.aiven.live/mcp?read_only=true"
    },
    "vps-db": {
      "command": "python",
      "args": ["${workspaceFolder}/scripts/mcp_vps_db.py"],
      "env": {
        "VPS_SSH_KEY": "${workspaceFolder}/.ssh/artalk_vps"
      }
    }
  }
}
