{
  "mcpServers": {
    "posthog": {
      "url": "https://mcp.posthog.com/mcp"
    },
    "viaduct": {
      "url": "https://mcp.quietgridlabs.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:VIADUCT_MCP_TOKEN}"
      }
    },
    "aiven": {
      "type": "http",
      "url": "https://mcp.aiven.live/mcp?read_only=true"
    },
    "vps-db": {
      "command": "python3",
      "args": ["scripts/mcp_vps_db.py"]
    }
  }
}
