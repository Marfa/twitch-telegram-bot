TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
# Public HTTPS origin for Twitch OAuth (import follows) and EventSub webhooks
PUBLIC_BASE_URL=https://bot.themarfa.name
# Optional 10–100 char secret for EventSub HMAC. Unset: derived from TELEGRAM_BOT_TOKEN.
# TWITCH_EVENTSUB_SECRET=
CHECK_INTERVAL=60
# Schedule reminder poll, sec (default 180; one Helix call per reminder channel)
SCHEDULE_CHECK_INTERVAL=180
# Health/OAuth port (default 8080)
PORT=8080
# Telegram user IDs with admin menu (comma-separated):
ADMIN_USER_IDS=your_telegram_user_id
# Local SQLite (default when DATABASE_URL is unset):
DATABASE_PATH=data/bot.db
# VPS (compose.vps.yml): required for Postgres; DATABASE_URL is set by compose
VPS_HOST=your_vps_host
VPS_USER=your_vps_user
VPS_SSH_KEY=your_vps_ssh_key

POSTGRES_PASSWORD=change_me
# Production: PostgreSQL connection string (VPS compose sets this automatically)
DATABASE_URL=postgres://bot:pass@db:5432/bot?sslmode=disable
# VPS only: Aiven URI for nightly cold DR mirror (not used by the bot). Prefer sslmode=require.
# AIVEN_DATABASE_URL=postgres://avnadmin:pass@HOST:PORT/defaultdb?sslmode=require
# Optional: Fernet key for Twitch refresh tokens (url-safe base64).
# If unset, a key is derived from TELEGRAM_BOT_TOKEN.
TOKEN_ENCRYPTION_KEY=
# Optional: max subscriptions per Telegram user (default 25)
MAX_SUBSCRIPTIONS_PER_OWNER=25
# Product flags (default 0 in source = OSS: paid features free, no Help button, no Partner).
# On VPS set all three to 1 for production monetization.
ENABLE_PREMIUM=0
ENABLE_HELP=0
ENABLE_PARTNER=0
# Premium: free active-alert limit, Stars prices, trial, Twitch channel for sub check
PREMIUM_FREE_ACTIVE_LIMIT=5
PREMIUM_STARS_AMOUNT=100
PREMIUM_STARS_YEAR=1000
PREMIUM_STARS_LIFETIME=2000
PREMIUM_STARS_FEATURE=20
PREMIUM_CHANNEL_STARS=1500
PREMIUM_TRIAL_DAYS=7
PREMIUM_SUBSCRIPTION_PERIOD=2592000
PREMIUM_TWITCH_LOGIN=marfapr
# Premium entitlements / feature gates (должно совпадать с premium.FEATURE_IDS)
FEATURE_IDS=extra_alerts,alert_types,twitch_sync,advanced_mode,schedule_publish,alert_history,deleted_subscriptions_cart
# FREE_CHAT_ID=-1002155969539
# Partner program: commission % and min withdrawal (Stars)
REFERRAL_COMMISSION_PERCENT=10
REFERRAL_WITHDRAW_MIN_STARS=500
# Optional: auto-translate admin broadcasts (DeepL)
DEEPL_API_KEY=your_deepl_api_key
# Optional: PostHog product analytics + error tracking + WARNING/ERROR logs (Cloud)
POSTHOG_API_KEY=phc_xxx
# US (default): https://us.i.posthog.com — EU: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
# Logs: OTLP WARNING+ only, service.name=twitch-telegram-bot (same key/host)
# Shared secret for PostHog Issue alerts webhook (Authorization: Bearer …)
POSTHOG_ISSUE_WEBHOOK_SECRET=
# Personal API key for Inbox reports polling (phx_…). Empty = polling off.
POSTHOG_API_KEY_PERSONAL=
# POSTHOG_PROJECT_ID=554824
