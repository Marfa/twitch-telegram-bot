TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
# Public HTTPS origin for Twitch OAuth (import follows), e.g. https://bot.example.com
# PUBLIC_BASE_URL=https://bot.themarfa.name
CHECK_INTERVAL=60
# Schedule reminder poll, sec (default 180; one Helix call per reminder channel)
# SCHEDULE_CHECK_INTERVAL=180
# Telegram user IDs with admin menu (comma-separated):
ADMIN_USER_IDS=your_telegram_user_id
# Local SQLite (default when DATABASE_URL is unset):
DATABASE_PATH=data/bot.db
# VPS (compose.vps.yml): required for Postgres; DATABASE_URL is set by compose
# POSTGRES_PASSWORD=change_me
# Production: PostgreSQL connection string (VPS compose sets this automatically)
# DATABASE_URL=postgres://bot:pass@db:5432/bot?sslmode=disable
# Optional: Fernet key for Twitch refresh tokens (url-safe base64).
# If unset, a key is derived from TELEGRAM_BOT_TOKEN.
# TOKEN_ENCRYPTION_KEY=
# Optional: max subscriptions per Telegram user (default 25)
# MAX_SUBSCRIPTIONS_PER_OWNER=25
# Premium: free active-alert limit, Stars prices, trial, Twitch channel for sub check
# PREMIUM_FREE_ACTIVE_LIMIT=5
# PREMIUM_STARS_AMOUNT=100
# PREMIUM_STARS_YEAR=1000
# PREMIUM_STARS_LIFETIME=2000
# PREMIUM_STARS_FEATURE=20
# PREMIUM_TRIAL_DAYS=7
# PREMIUM_SUBSCRIPTION_PERIOD=2592000
# PREMIUM_TWITCH_LOGIN=marfapr
# FREE_CHAT_ID=-1002155969539
# Partner program: commission % and min withdrawal (Stars)
# REFERRAL_COMMISSION_PERCENT=10
# REFERRAL_WITHDRAW_MIN_STARS=500
# Optional: auto-translate admin broadcasts (DeepL)
# DEEPL_API_KEY=your_deepl_api_key
# Optional: Hugging Face token for «I'm feeling lucky» (fallback after Groq)
# HF_TOKEN=hf_xxx
# HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional: Groq API (preferred for lucky templates; GROK_API is accepted as an alias)
# GROQ_API_KEY=gsk_xxx
# GROQ_TEXT_MODEL=llama-3.1-8b-instant
# Optional: PostHog product analytics + error tracking (Cloud; no self-host)
# POSTHOG_API_KEY=phc_xxx
# US (default): https://us.i.posthog.com — EU: https://eu.i.posthog.com
# POSTHOG_HOST=https://us.i.posthog.com
